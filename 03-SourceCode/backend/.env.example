NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# Enable both only behind the loopback reverse proxy with a valid TLS certificate.
TRUST_PROXY_LOOPBACK=false
ENFORCE_HTTPS=false
FRONTEND_ORIGIN=http://localhost:3000
SQLSERVER_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=QuanLyChuongTrinhDaoTao;Trusted_Connection=yes;TrustServerCertificate=yes;"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=training-api
JWT_AUDIENCE=training-web
DEV_LOGIN_ENABLED=true
PASSWORD_LOGIN_ENABLED=true
DEV_CAN_BO_ID=1
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=

# Email khoi phuc mat khau (dien thong tin rieng tren may)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_ORIGIN=http://localhost:3000

# AES-256-GCM: 32 random bytes as 64 hexadecimal characters. Keep with backups.
DATA_ENCRYPTION_KEY=
PUBLIC_WEB_ORIGIN=http://localhost:3000
ADMISSION_JOBS_AUTO=true
# Optional: absolute private directory; never put under frontend/public
ADMISSION_UPLOAD_DIRECTORY=
OCR_LANG_PATH=

# VNPAY sandbox; callbacks must reach /api/integrations/vnpay/ipn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/tuyen-sinh

# MoMo captureWallet: IPN must be publicly reachable over HTTPS.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=
MOMO_IPN_URL=

# HTTPS/TLS 1.3 adapter endpoints; positive acknowledgement required
OCR_ENDPOINT=
OCR_TOKEN=
SMS_ENDPOINT=
SMS_TOKEN=
ERP_ENDPOINT=
ERP_TOKEN=
SIGNATURE_ENDPOINT=
SIGNATURE_TOKEN=
