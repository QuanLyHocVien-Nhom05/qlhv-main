{
  "name": "qlhv-training-programs",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "overrides": {
    "multer": "^2.5.0",
    "rollup": "npm:@rollup/wasm-node@4.68.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run start:dev -w backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "setup:local": "npm run setup:local -w backend",
    "test:acceptance": "node backend/scripts/acceptance.cjs"
  },
  "devDependencies": {
    "rollup": "npm:@rollup/wasm-node@4.68.0"
  }
}
